{
  "version": 2,
  "routes": [
    {
      "src": "/callback",
      "dest": "/api/callback.js"
    },
    {
      "src": "/privacy",
      "dest": "/api/privacy.js"
    },
    {
      "src": "/whoop/login",
      "dest": "/api/whoop-login.js"
    },
    {
      "src": "/whoop/data",
      "dest": "/api/whoop-data.js"
    },
    {
      "src": "/google/login",
      "dest": "/api/google-login.js"
    },
    {
      "src": "/google/callback",
      "dest": "/api/google-callback.js"
    },
    {
      "src": "/google/data",
      "dest": "/api/google-data.js"
    },
    {
      "src": "/store",
      "dest": "/api/store.js"
    },
    {
      "src": "/brief",
      "dest": "/api/brief.js"
    },
    {
      "src": "/daily",
      "dest": "/api/daily.js"
    },
    {
      "src": "/push/subscribe",
      "dest": "/api/push-subscribe.js"
    },
    {
      "src": "/sw.js",
      "dest": "/api/sw.js"
    },
    {
      "src": "/manifest.json",
      "dest": "/api/manifest.js"
    },
    {
      "src": "/ai",
      "dest": "/api/ai.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/daily",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/daily",
      "schedule": "30 0 * * *"
    }
  ]
}
